# Runtime
RUN_MODE=once
LOG_LEVEL=INFO
LOGS_DIR=./logs
LOG_FILE=bank_importer.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
APP_ENV=development
LOG_LEVEL=INFO
POLL_INTERVAL_SECONDS=300
DATABASE_URL=sqlite:////app/data/bank_importer.sqlite3

# IMAPS mailbox
IMAP_HOST=mx.example.com
IMAP_PORT=993
IMAP_USE_SSL=true
IMAP_USER=relever_bank@gmail.com
IMAP_PASSWORD_SIT_PALAIS=XXXXXXXXXXXXXXXXXX
IMAP_FOLDER=INBOX

# Default Odoo target.
# Multi-client values belong in config/clients.yml.
ODOO_URL=https://odoo-example.com
ODOO_DB=NAME_OF_YOUR_DATABASE
ODOO_USER=user@example.com
ODOO_PASSWORD=XXXXXXXXXXXXX