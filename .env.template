# Runtime
LOG_LEVEL=INFO
LOGS_DIR=./logs
LOG_FILE=bank_importer.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
RUN_MODE=api
POLL_INTERVAL_SECONDS=300
API_HOST=0.0.0.0
API_PORT=8080
API_TOKEN=change-this-token
DATABASE_URL=sqlite:///./data/bank_importer.sqlite3
CLIENTS_CONFIG_PATH=./config/clients.yml

# Passwords for specific clients (referenced in clients.yml)
# Example for Vinamora:
# VINAMORA_ODOO_PASSWORD=your-password
# VINAMORA_IMAP_PASSWORD=your-password
